---
import { Image, getImage } from 'astro:assets';
import fontUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import logo from '../../assets/The-Vine-Marketing-Official-Logo-Transparent.png';
import Icon from '../components/Icon.astro';
import { contact, nav, primaryCta, social } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  showTestCta?: boolean;
}
const { title, description, showTestCta = true } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const favicon = await getImage({ src: logo, width: 64, height: 64, format: 'png' });
const touchIcon = await getImage({ src: logo, width: 180, height: 180, format: 'png' });
const ogImage = await getImage({ src: logo, width: 400, height: 400, format: 'png' });
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="theme-color" content="#0D0D0D" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={`@font-face{font-family:'Bricolage';font-style:normal;font-display:swap;font-weight:200 800;src:url(${fontUrl}) format('woff2-variations'),url(${fontUrl}) format('woff2');}`}></style>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark';
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-head">
        <a class="brand" href="/" aria-label="The Vine Marketing, home">
          <Image src={logo} alt="" width={112} widths={[40, 56, 80, 112]} sizes="(min-width: 1024px) 56px, 40px" loading="eager" fetchpriority="high" class="brand-logo" />
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul id="nav-list" class="nav-list">
            {nav.map((item) => <li><a href={item.href} aria-current={here === item.href ? 'page' : undefined}>{item.label}</a></li>)}
          </ul>
        </nav>
        <div class="head-actions">
          <button class="icon-btn theme-btn" type="button" aria-label="Switch to light theme" data-theme-toggle>
            <span class="when-dark"><Icon name="sun" /></span>
            <span class="when-light"><Icon name="moon" /></span>
          </button>
          <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="nav-list" data-menu-toggle>
            <span class="menu-open"><Icon name="menu" /></span>
            <span class="menu-close"><Icon name="close" /></span>
            <span class="visually-hidden">Menu</span>
          </button>
          {showTestCta && <a class="head-cta" href={primaryCta.href}>Free 5-point test</a>}
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-foot">
        <Image src={logo} alt="" width={112} widths={[40, 56, 80, 112]} sizes="(min-width: 1024px) 56px, 40px" class="foot-logo" />
        <div class="foot-body">
          <p class="foot-name">The Vine Marketing · {contact.location}</p>
          <ul class="foot-links">
            {social.map((s) => <li><a href={s.href} rel="me noopener">{s.label} <span class="soft">{s.handle}</span></a></li>)}
            <li><a href={contact.whatsappHref}>WhatsApp <span class="soft">{contact.whatsappDisplay}</span></a></li>
            <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          </ul>
          <p class="foot-legal"><a href="/privacy">Privacy</a> <span aria-hidden="true">·</span> © {year} The Vine Marketing</p>
        </div>
      </footer>
    </div>

    <script>
      import { initChrome } from '../scripts/chrome';
      initChrome();
    </script>
  </body>
</html>
