---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import founderPhoto from '../../assets/lourence-erasmus.jpg';
import EnquiryForm from '../components/EnquiryForm.astro';
import Routes from '../components/Routes.astro';
import heroArt from '../../assets/hero-vine-concept.png';
import { contact, primaryCta } from '../config/site';
import { foundingLine, formatPrice, prices } from '../data/pricing';

const pillars = [
  { label: 'Websites', href: '/websites' },
  { label: 'Follow-up, AI and automation', href: '/follow-up-ai-automation' },
  { label: 'Marketing', href: '/marketing' },
];

// The four orbs in the hero artwork, as a share of the image (x, y).
const journey = [
  { n: 1, name: 'Attention', line: 'They notice you', x: 49.2, y: 54.7 },
  { n: 2, name: 'Enquiry', line: 'They reach out', x: 61.5, y: 41.2 },
  { n: 3, name: 'Acknowledgement', line: 'An instant reply', x: 73.7, y: 31.4 },
  { n: 4, name: 'Human follow-up', line: 'A person takes it from there', x: 83.7, y: 24.4 },
];

const leaks = [
  { title: 'The enquiry never arrives.', body: 'A form can look fine and still send messages nowhere, so nobody knows an enquiry was missed.', status: 'Sent 19:42 · not received' },
  { title: 'The reply comes late.', body: 'When a reply takes hours or days, the customer may already have asked someone else.', status: 'Sent 19:42 · answered 11:05 next day' },
  { title: 'The next step isn’t clear.', body: 'A reply that doesn’t say what happens next can leave the customer unsure what to do.', status: 'Replied 19:44 · no next step' },
  { title: 'Nobody follows up.', body: 'If the customer goes quiet after the first reply, the enquiry can end right there.', status: 'Last message 19:44 · no follow-up since' },
  { title: 'It reaches the wrong person.', body: 'An enquiry can land in an inbox nobody checks, or with someone who can’t help.', status: 'Delivered 19:42 · inbox not checked' },
];

const system = [
  { n: 1, name: 'Marketing', line: 'Brings the right people to you, before they enquire.', detail: 'Organic social content and Meta ads management.', href: '/marketing' },
  { n: 2, name: 'Websites', line: 'Gives them a clear way to reach you when they’re ready.', detail: 'Website design and build, with hosting and care.', href: '/websites' },
  { n: 3, name: 'Follow-up, AI and automation', line: 'Makes sure every enquiry gets an answer, and a follow-up.', detail: 'Lead capture, instant replies, CRM follow-up, AI agents and automation.', href: '/follow-up-ai-automation' },
];

const steps = [
  { n: 1, day: 'Monday', title: 'You ask', text: 'You request the free 5-point test.', time: '09:10' },
  { n: 2, day: 'Monday', title: 'You approve, we send it', text: 'Once you approve it, we send one clearly labelled test enquiry through your website form.', time: '09:12' },
  { n: 3, day: 'Monday', title: 'We watch', text: 'Then we watch what happens and check five things.', time: '09:30' },
  { n: 4, day: 'Tuesday', title: 'Within one business day', text: 'Here are your five findings, the biggest gap and one first fix.', time: '09:05' },
];
const checks = ['Does the enquiry arrive?', 'How quickly does someone reply?', 'Is the next step clear?', 'Does anyone follow up?', 'Does it reach the right person?'];

const ladder = ['care', 'care-plus', 'grow', 'partner'].map((id) => prices.find((p) => p.id === id)!);
const startSmaller = ['lead-response-test', 'quick-fix', 'website-3', 'website-5', 'website-premium']
  .map((id) => prices.find((p) => p.id === id)!)
  .filter((p) => !p.onlyOn);
---
<Base
  title="The Vine Marketing · Turn more enquiries into paying customers"
  description="We build the websites, follow-up systems and marketing that help small and growing South African businesses turn more enquiries into paying customers."
>
  <!-- Hero: the vine, and the journey an enquiry takes -->
  <section class="stage band-dark" aria-labelledby="hero-title">
    <div class="stage-art" aria-hidden="true">
      <Image
        src={heroArt}
        alt=""
        widths={[640, 960, 1280, 1672]}
        sizes="(min-width: 1272px) 1240px, calc(100vw - 32px)"
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
        class="stage-img"
      />
      <span class="stage-shade"></span>
      {journey.map((j) => <span class="orb" style={`--x:${j.x}%;--y:${j.y}%`}><i></i></span>)}
    </div>

    <div class="stage-copy">
      <p class="eyebrow">The Vine Marketing · {contact.location}</p>
      <h1 id="hero-title">Turn more enquiries into paying customers.</h1>
      <p class="stage-sub">We build the websites, follow-up systems and marketing that help small and growing South African businesses turn more enquiries into paying customers.</p>
      <div class="quick">
        <a class="btn btn-primary" href={primaryCta.href}>{primaryCta.label}<Icon name="arrow" /></a>
        <ul class="pillar-row" aria-label="What we do">
          {pillars.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
        </ul>
      </div>
    </div>

    <ol class="journey" aria-label="The path an enquiry takes (illustrative)">
      {journey.map((j) => (
        <li class={`stop${j.n % 2 === 0 ? ' up' : ''}`} style={`--x:${j.x}%;--y:${j.y}%`}>
          <span class="stop-n" aria-hidden="true">{j.n}</span>
          <span class="stop-text"><strong>{j.name}</strong><span>{j.line}</span></span>
        </li>
      ))}
    </ol>
    <p class="illustrative">Illustrative journey, not a client result.</p>
  </section>

  <!-- Five places an enquiry can slip away -->
  <section class="block leaks" aria-labelledby="leaks-title">
    <div class="leaks-intro">
      <h2 id="leaks-title">Five places an enquiry can slip away.</h2>
      <p class="lede">Any one of these can happen without anyone noticing.</p>
      <p class="leak-close">The free test checks all five on your own website form.</p>
      <a class="text-link" href={primaryCta.href}>{primaryCta.label}<Icon name="arrow" size={18} /></a>
    </div>
    <ol class="leak-list">
      {leaks.map((leak, i) => (
        <li class="leak">
          <span class="leak-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{leak.title}</h3>
            <p>{leak.body}</p>
            <p class="status"><span class="status-dot" aria-hidden="true"></span>{leak.status}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- One connected system -->
  <section class="block system" aria-labelledby="system-title">
    <h2 id="system-title">One connected system, from first look to follow-up.</h2>
    <div class="system-grid">
      <figure class="ring" aria-hidden="true">
        <svg viewBox="0 -30 400 400" role="img" focusable="false">
          <defs>
            <marker id="tip" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M1 1 L8 5 L1 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </marker>
            <radialGradient id="node-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#D9B384" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#D9B384" stop-opacity="0" />
            </radialGradient>
          </defs>
          <circle class="ring-guide" cx="200" cy="200" r="130" />
          <path class="ring-arc" d="M248.7 79.5 A130 130 0 0 1 328.7 218.1" marker-end="url(#tip)" />
          <path class="ring-arc" d="M280 302.4 A130 130 0 0 1 120 302.4" marker-end="url(#tip)" />
          <path class="ring-arc" d="M71.3 218.1 A130 130 0 0 1 151.3 79.5" marker-end="url(#tip)" />
          <g class="ring-node"><circle cx="200" cy="70" r="58" fill="url(#node-glow)" /><circle cx="200" cy="70" r="32" /><text x="200" y="77" text-anchor="middle">1</text><text class="ring-label" x="200" y="12" text-anchor="middle">Marketing</text></g>
          <g class="ring-node"><circle cx="312.6" cy="265" r="58" fill="url(#node-glow)" /><circle cx="312.6" cy="265" r="32" /><text x="312.6" y="272" text-anchor="middle">2</text><text class="ring-label" x="312.6" y="342" text-anchor="middle">Websites</text></g>
          <g class="ring-node"><circle cx="87.4" cy="265" r="58" fill="url(#node-glow)" /><circle cx="87.4" cy="265" r="32" /><text x="87.4" y="272" text-anchor="middle">3</text><text class="ring-label" x="87.4" y="342" text-anchor="middle">Follow-up &amp; AI</text></g>
          <text class="ring-core" x="200" y="196" text-anchor="middle">Enquiries</text>
          <text class="ring-core" x="200" y="218" text-anchor="middle">to customers</text>
        </svg>
      </figure>
      <ul class="system-list">
        {system.map((b) => (
          <li>
            <span class="system-n" aria-hidden="true">{b.n}</span>
            <div>
              <h3><a href={b.href}>{b.name}<Icon name="arrow" /></a></h3>
              <p class="system-line">{b.line}</p>
              <p class="system-detail">{b.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How the free test works -->
  <section class="block test" aria-labelledby="test-title">
    <h2 id="test-title">How the free <span class="nowrap">5-point</span> test works.</h2>
    <p class="thread-label">Example timeline</p>
    <ol class="path">
      {steps.map((s) => (
        <li class="path-step">
          <span class="path-dot" aria-hidden="true">{s.n}</span>
          <p class="path-when">{s.day} · <time>{s.time}</time></p>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          {s.n === 3 && (
            <ul class="checks">
              {checks.map((c) => <li><Icon name="check" size={18} />{c}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ol>
    <div class="test-foot">
      <p class="system-note">No logins or system access needed.</p>
      <a class="btn btn-primary" href={primaryCta.href}>{primaryCta.label}<Icon name="arrow" /></a>
    </div>
  </section>

  <!-- Prices -->
  <section class="block prices band-dark" aria-labelledby="prices-title">
    <div class="band-inner">
      <h2 id="prices-title">Prices, in plain rand.</h2>
      <p class="lede">Each price says exactly what it is. {foundingLine}</p>

      <div class="price-stage">
        <div>
          <h3 class="price-kicker">Monthly: each step builds on the one before</h3>
          <ol class="ladder">
            {ladder.map((p, i) => (
              <li class="rung" style={`--step:${i + 1}`}>
                <p class="rung-name">{p.name}</p>
                <p class="rung-price"><span class="amt">R{p.amount?.toLocaleString('en-US')}</span> <span class="per">a month</span></p>
                <p class="rung-what">{p.what}</p>
                {p.note && <p class="rung-note">{p.note}</p>}
              </li>
            ))}
          </ol>
          <p class="price-links"><a class="text-link" href="/follow-up-ai-automation">See what each package includes<Icon name="arrow" size={18} /></a></p>
        </div>
        <div class="starter">
          <h3 class="price-kicker">Start smaller</h3>
          <dl>
            {startSmaller.map((p) => (
              <div class="ledger-row">
                <dt>{p.name}</dt>
                <dd class="ledger-price">{formatPrice(p)}</dd>
                <dd class="ledger-what">{p.what}</dd>
              </div>
            ))}
          </dl>
          <p class="price-links"><a class="text-link" href="/websites">What a website includes<Icon name="arrow" size={18} /></a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Platforms -->
  <section class="block platforms" aria-labelledby="platforms-title">
    <h2 id="platforms-title">Running a medium business?</h2>
    <p>We also plan and build custom digital platforms for medium businesses, quoted to scope.</p>
    <a class="text-link" href="/platforms">See Platforms<Icon name="arrow" size={18} /></a>
  </section>

  <!-- About -->
  <section class="block about" aria-labelledby="about-title">
    <h2 id="about-title">Who you’ll be talking to.</h2>
    <div class="about-grid">
      <figure class="founder">
        <Image src={founderPhoto} alt="Lourence Erasmus, founder of The Vine Marketing" width={720} widths={[320, 480, 720]} sizes="(min-width: 720px) 240px, 70vw" loading="lazy" />
        <figcaption>Lourence Erasmus<span>Founder</span></figcaption>
      </figure>
      <div class="about-copy">
        <p>The Vine Marketing is based in {contact.location}.</p>
        <p class="placeholder-text" data-placeholder="founder-intro">Founder introduction to come.</p>
        <a class="text-link" href="/about">About<Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- Close: general enquiry -->
  <section class="block close" id="contact" aria-labelledby="close-title">
    <h2 id="close-title">Rather talk it through first?</h2>
    <p class="lede">Send a short message and you’ll get an instant reply to confirm we have it.</p>
    <EnquiryForm />
    <Routes />
  </section>
</Base>

<script>
  import { initHome } from '../scripts/home';
  initHome();
</script>
