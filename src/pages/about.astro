---
import { Image } from 'astro:assets';
import founderPhoto from '../../assets/lourence-erasmus.jpg';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../config/site';
---
<Base title="About · The Vine Marketing" description="The Vine Marketing is a digital agency in Rustenburg, working with small and growing businesses across South Africa.">
  <section class="page-head" aria-labelledby="t">
    <p class="eyebrow">About</p>
    <h1 id="t">Who you’ll be talking to.</h1>
    <p class="lede">The Vine Marketing is based in {contact.location} and works with small and growing businesses across South Africa.</p>
  </section>
  <section class="block" aria-label="Founder">
    <div class="about-grid">
      <figure class="founder">
        <Image src={founderPhoto} alt="Lourence Erasmus, founder of The Vine Marketing" width={720} widths={[320, 480, 720]} sizes="(min-width: 720px) 240px, 70vw" loading="eager" />
        <figcaption>Lourence Erasmus<span>Founder</span></figcaption>
      </figure>
      <div class="about-copy">
        <h2 class="about-name">Meet Lourence, founder of The Vine Marketing</h2>
        <p>I started The Vine to help small and growing businesses make their digital presence work together, from the first impression to the enquiry and the follow-up.</p>
        <p>I believe good marketing should be clear, practical and built around the business behind it. So we start with a few short sessions to find the biggest constraint holding your business back. Then I build the fix: a website, a follow-up automation, marketing, or a larger system.</p>
        <p>Many things have clear set prices. Anything bigger or more specific, I scope and quote for you.</p>
        <p>I’m based in {contact.location} and work with businesses across South Africa. When you contact The Vine, you deal with me directly.</p>
        <a class="btn btn-primary" href="/contact">Get in touch<Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>
